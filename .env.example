# MongoDB Atlas: Database > Clusters > Connect > Drivers > Python
MONGO_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB_NAME=sales_dashboard

# Generate a long random value for signing login/refresh JWTs.
SECRET_KEY=replace-with-a-long-random-secret

# Public frontend origin. Reset links are built from this URL.
FRONTEND_URL=http://localhost:3000

# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL="Sales Dashboard <onboarding@resend.dev>"

RESET_TOKEN_TTL_MINUTES=60
RESET_REQUEST_COOLDOWN_SECONDS=60
